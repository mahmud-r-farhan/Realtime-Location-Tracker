{
  "name": "realtime_tracker",
  "version": "5.0.0",
  "description": "Real-Time Location Tracker with SOS Emergency alerts, PWA support, WebRTC audio, and live chat",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.js",
    "test:browser": "node --test tests/browser/*.test.js"
  },
  "keywords": [
    "realtime",
    "location-tracker",
    "leaflet",
    "socket.io",
    "webrtc",
    "pwa",
    "sos-alert"
  ],
