  "license": "ISC",
  "dependencies": {
    "compression": "^1.7.5",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.2.0",
    "leaflet": "^1.9.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "playwright-core": "~1.60.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
